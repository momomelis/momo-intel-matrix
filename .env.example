# ── Deployer ─────────────────────────────────────────────────────
# Private key of the wallet that will sign the deployment transaction.
# Never commit the real .env — this file is the template only.
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Network RPC endpoints ─────────────────────────────────────────
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ── Explorer API keys (for contract verification) ─────────────────
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# ── Contract constructor arguments ────────────────────────────────
# Treasury — receives all mint ETH immediately upon each mint.
TREASURY_ADDRESS=0xYOUR_TREASURY_MULTISIG_ADDRESS

# IPFS base URI for revealed token metadata (must end with /).
# Example: ipfs://QmXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/
BASE_URI=ipfs://YOUR_IPFS_BASE_CID/

# IPFS URI for the single pre-reveal metadata file.
# Example: ipfs://QmXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/unrevealed.json
UNREVEALED_URI=ipfs://YOUR_UNREVEALED_CID/unrevealed.json

# IPFS URI for contract-level metadata (OpenSea storefront info).
# Example: ipfs://QmXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/contract.json
CONTRACT_METADATA_URI=ipfs://YOUR_CONTRACT_META_CID/contract.json

# ── Optional ──────────────────────────────────────────────────────
# Set to "true" to print gas usage in test output
REPORT_GAS=false
# CoinMarketCap key for USD gas cost estimation
COINMARKETCAP_API_KEY=
